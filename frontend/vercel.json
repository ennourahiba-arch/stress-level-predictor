{
  "rewrites": [{ "source": "/((?!packs/|assets/|icons/|favicon|sw\\.js|manifest\\.webmanifest).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/packs/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
